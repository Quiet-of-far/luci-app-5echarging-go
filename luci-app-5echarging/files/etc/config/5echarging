config 5echarging 'global'
	option enabled '1'
	option low_energy_threshold '15'
	option depletion_alert_days '0'
	option db_path '/etc/5echarging/5echarging.bbolt'
	option max_records_per_room '500'

config schedule 'schedule'
	option interval_minutes '60'
	list check_hours '8'
	list check_hours '12'
	list check_hours '18'
	list check_hours '22'

config room
	option building '44'
	option room '1207'
	option label '44栋1207'

config prediction 'prediction'
	option sample_count '10'
	option custom_daily_consumption '0'

config email 'email'
	option enabled '0'
	option alert_once_per_day '0'
	option smtp_host ''
	option smtp_port '587'
	option username ''
	option password ''
	option from_addr ''
